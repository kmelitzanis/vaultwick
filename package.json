{
  "name": "vaultwick",
  "version": "1.1.0",
  "description": "Password-protected network drive mounter",
  "author": {
    "name": "Kostas Melitzanis",
    "email": "kostasmel117@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder --mac --win --linux --publish never",
    "format:check": "prettier --check .",
    "changelog": "node scripts/changelog.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "build": {
    "appId": "com.vaultwick.app",
    "productName": "Vaultwick",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "lib/**",
      "assets/**",
      "package.json",
      "!**/*.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Vaultwick uses AppleScript to mount your network share."
      }
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kmelitzanis",
        "repo": "vaultwick",
        "releaseType": "draft"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Kostas Melitzanis <kostasmel117@gmail.com>"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kmelitzanis/vaultwick.git"
  }
}
